{
  "name": "todo-list",
  "version": "0.1.0",
  "description": "A local-first task and project manager desktop app with Carbon Design UI, calendar/kanban/gantt views, task dependencies, and a configurable AI agent.",
  "main": "./out/main/index.js",
  "author": "igormicadei",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "build:linux": "npm run build && electron-builder --linux --dir",
    "postinstall": "prisma generate && electron-builder install-app-deps"
  },
  "dependencies": {
    "@carbon/icons-react": "^11",
    "@carbon/react": "^1",
    "@dnd-kit/core": "^6",
    "@dnd-kit/sortable": "^8",
    "@dnd-kit/utilities": "^3",
    "@editorjs/checklist": "^1",
    "@editorjs/editorjs": "^2",
    "@editorjs/header": "^2",
    "@editorjs/list": "^2",
    "@editorjs/paragraph": "^2",
    "@prisma/client": "^5",
    "@tanstack/react-query": "^5",
    "better-sqlite3": "^11",
    "cors": "^2",
    "date-fns": "^3",
    "express": "^4",
    "gantt-task-react": "^0.3",
    "helmet": "^7",
    "react": "^18",
    "react-big-calendar": "^1",
    "react-dom": "^18",
    "react-router-dom": "^6",
    "zod": "^3",
    "zustand": "^4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7",
    "@types/cors": "^2",
    "@types/express": "^4",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4",
    "electron": "^31",
    "electron-builder": "^24",
    "electron-vite": "^2",
    "playwright": "^1",
    "prisma": "^5",
    "sass": "^1",
    "typescript": "^5",
    "vite": "^5"
  }
}
